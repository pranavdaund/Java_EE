package org.pranav.dao;

import static org.pranav.util.DBUtils.openConnection;
import static org.pranav.util.DBUtils.openExecuteQuery;
import static org.pranav.util.DBUtils.openPreparedStatement;

import java.sql.Connection;
import java.sql.Date;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

import org.pranav.pojos.Employee;

public class EmployeeDaoImp implements IEmployeeDao {
	// state: instance vars
	private Connection cn;
	private PreparedStatement pst1, pst2;

	public EmployeeDaoImp() throws SQLException {
		// TODO Auto-generated constructor stub
		cn = openConnection("person");
		pst1 = openPreparedStatement(
				"Select id, name, salary, join_date from emp where deptid=? and join_date between ? and ? ");
		
		pst2 = openPreparedStatement("insert into emp values(?,?,?,?,?");
		System.out.println("emp dao is created...");
	}

	@Override
	public List<Employee> getSelectedEmpDetails(String dept, Date beginDate, Date endDate) throws SQLException {
		List<Employee> emps = new ArrayList<>();
		// set IN parameter
		pst1.setString(1, dept);
		pst1.setDate(2, beginDate);
		pst1.setDate(3, endDate);

		try (ResultSet rst = openExecuteQuery()) {

			while (rst.next()) {
				emps.add(new Employee(rst.getInt(1), rst.getString(2), rst.getDouble(3), rst.getDate(4)));
			}

		}

		return emps;
	}

	@Override
	public String insertEmpDetails(Employee employee) throws SQLException {

	}

	// add a method to clean up db reso
	public void cleanUp() throws SQLException {
		if (pst1 != null) {
			pst1.close();
		}
		if (cn != null) {
			cn.close();
		}

		System.out.println("emp dao clean up!");

	}

}
